# config.env.example - Template for personal configuration
# Copy this file to config.env and fill in your values:
#   cp config.env.example config.env
#   nano config.env
#
# config.env is gitignored - your personal details never get committed.
# This example file IS committed - it shows others what values are needed.

# Your identity
DOTFILES_USER_NAME="Your Full Name"
DOTFILES_USER_EMAIL="you@example.com"

# Your GitHub username (used in clone URLs and README)
DOTFILES_GITHUB_USERNAME="yourusername"

# Your Windows username (used in file paths like C:\Users\<name>)
DOTFILES_WINDOWS_USERNAME="yourwindowsusername"

# Full path to your GitHub directory in WSL (used in shell navigation aliases)
DOTFILES_GITHUB_PATH="/mnt/c/Users/yourwindowsusername/Documents/GitHub"

# Full path to your GitHub directory in WINDOWS terms, for the user/ tree.
# Only needed on a machine with no WSL. Leave it empty and the user/ scripts assume
# %USERPROFILE%\Documents\GitHub. Never a translation of the WSL path above: a machine with no
# WSL has no /mnt/c, so a translated path would resolve nowhere.
DOTFILES_GITHUB_PATH_WIN=""

# ── Machine attributes ────────────────────────────────────────────────────────
# These describe what THIS machine is and what it can do. 0_personalize writes them into
# TDBI's config/machine.local.json, which is how the grid learns a machine's capabilities
# instead of matching its name against a hardcoded list.

# Which AI coding assistant this machine deploys, as a VS Code extension ID.
# A machine with no local admin may not be permitted all of them; "none" is a complete answer.
#   GitHub.copilot        - GitHub Copilot. NOTE: current VS Code SHIPS Copilot as a built-in, so
#                           installing it fails ("cannot be downgraded") on a machine that already
#                           has it. If the Extensions panel shows Copilot, use "none" here.
#   anthropic.claude-code - Claude Code
#   Continue.continue     - Continue (can point at a local or self-hosted model)
#   none                  - install no AI extension, including when the editor already provides one
DOTFILES_AI_EXTENSION="anthropic.claude-code"

# Does this machine have a git-annex backup remote it can actually copy L0 content TO?
# "true" only if a remote exists AND the content lives on this disk. When false, TDBI's evidence
# gate warns instead of blocking, which is correct for a machine with nowhere to copy to -- a
# gate that cannot be cleared is a wall, not a gate.
DOTFILES_BACKUP_REMOTE="false"

# Your first project name (created as a VS Code workspace config). OPTIONAL.
# Format: p###-project-name (e.g. p008-arcane-predictive), or "none" to skip it.
# Use "none" on a machine whose work is cloned repos rather than scratch projects.
# NEVER name this after a client: 2_vscode/projects/ is committed, and a company name in the
# committed tree is exactly what the gitignored company registry exists to prevent.
DOTFILES_FIRST_PROJECT="none"
